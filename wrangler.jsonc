{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cashflow-expense-manager",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cashflow-db",
      "database_id": "7c3890ab-6ff6-414e-a2eb-8157ece2924a"
    }
  ],
  "observability": {
    "enabled": true
  }
}
